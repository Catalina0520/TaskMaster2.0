<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva tarea "
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/purple_dark"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="Icono tarea"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal" />

        <CheckBox
            android:id="@+id/cbUrgente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarea urgente"
            android:textColor="@color/text_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prioridad:"
            android:textColor="@color/purple_dark"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <RadioGroup
            android:id="@+id/rgPrioridad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBaja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baja" />

            <RadioButton
                android:id="@+id/rbMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Media" />

            <RadioButton
                android:id="@+id/rbAlta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Alta" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calificación de importancia:"
            android:textColor="@color/purple_dark"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <RatingBar
            android:id="@+id/ratingImportancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:progressTint="@color/purple_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso actual:"
            android:textColor="@color/purple_dark"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <ProgressBar
            android:id="@+id/progressTarea"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:progressTint="@color/purple_soft" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar tarea"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_rounded"
            android:layout_marginTop="28dp"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>
</ScrollView>